---
import "../../styles.css";
import { useTranslations } from "../../i18n/utils";
import { localeOptions, type Language } from "../../i18n/ui";
import BaseLayout from "../../layout/base-layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import LinkedInIcon from "../../assets/icons/linkedin.svg";
import GitHubIcon from "../../assets/icons/github.svg";
import HeroMeImage from "../../assets/images/hero-me.png";

const priorityOrder = { high: 1, medium: 2, low: 3 };

const locale = Astro.params.locale as Language;
const t = useTranslations(locale);
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.slug.startsWith(locale + "/"))
  .toSorted((a, b) => {
    const priorityA = priorityOrder[a.data.priority] ?? 4;
    const priorityB = priorityOrder[b.data.priority] ?? 4;

    return priorityA - priorityB;
  });

export async function getStaticPaths() {
  return localeOptions.map((locale) => ({ params: { locale } }));
}
---

<BaseLayout locale={locale}>
  <section id="hero" class="hero-section">
    <Image
      class="me-image"
      loading="eager"
      src={HeroMeImage}
      alt={t("hero.me")}
    />
    <h1 class="title">{t("hero.title")}</h1>
    <p class="description">{t("hero.description")}</p>
    <div class="socials">
      <a
        href="https://linkedin.com/in/christopher-alexander-lang"
        target="_blank"
        rel="noopener noreferrer"
        class="socials-anchor linkedin"
        aria-label={t("socials.linkedin")}
      >
        <LinkedInIcon class="socials-icon" />
      </a>
      <a
        href="https://github.com/chrisalxlng"
        target="_blank"
        rel="noopener noreferrer"
        class="socials-anchor github"
        aria-label={t("socials.github")}
      >
        <GitHubIcon class="socials-icon" />
      </a>
    </div>
  </section>

  <section id="portfolio" class="portfolio-section">
    <ul class="projects">
      {
        projects.map((project) => {
          const slug = project.slug.split("/")[1];
          return (
            <li id={slug} class="project">
              <a
                href={project.data.url}
                aria-label={project.data.title}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="project-thumbnail">
                  {project.data.screenshots.map((screenshot) => (
                    <Image
                      class="project-screenshot"
                      loading="eager"
                      src={screenshot}
                      alt={project.data.title}
                    />
                  ))}
                </div>
              </a>
              <div class="project-caption">
                <div class="project-caption-text">
                  <span class="project-title">{project.data.title}</span>
                  <span class="project-subtitle">{project.data.subtitle}</span>
                </div>
                <div class="project-caption-tags">
                  {project.data.tags.map((tag) => (
                    <span class="project-tag">{tag}</span>
                  ))}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
  <footer>&copy; {new Date().getFullYear()} {t("name")}</footer>
</BaseLayout>

<style>
  .hero-section {
    max-width: 600px;
    margin: 100px auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .me-image {
    user-select: none;
    width: 125px;
    height: 125px;
    border-radius: 50%;
  }

  .title {
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 600;
    font-size: var(--font-lg);
    letter-spacing: -0.04em;
    text-align: center;
  }

  .socials {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .description {
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 500;
    font-size: var(--font-sm);
    line-height: 1.5;
    text-align: center;
  }

  .socials-anchor {
    user-select: none;
    background: var(--color-accent);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .socials-anchor.linkedin {
    transition: all var(--duration-sm) ease-in-out;
    color: var(--color-typography-attention);
  }

  .socials-anchor.github {
    color: var(--color-typography-attention);
  }

  @media (hover: hover) {
    .socials-anchor.linkedin:hover {
      background: var(--color-linked-in);
      color: var(--color-on-linked-in);
    }

    .socials-anchor.github:hover {
      background: var(--color-github);
      color: var(--color-on-github);
    }
  }

  .socials-icon {
    width: 25px;
    height: 25px;
  }

  .portfolio-section {
    max-width: 900px;
    margin: 0 auto 100px auto;
    padding: 1rem;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--space-lg);
  }

  @media (max-width: 1000px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project a {
    display: flex;
    flex-direction: column;
  }

  .project-thumbnail {
    user-select: none;
    height: 300px;
    flex: none;
    background: var(--color-accent);
    border-radius: 15px;
    padding: var(--space-md);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-sm);
    align-items: center;
    justify-items: center;
    cursor: pointer;
    position: relative;
  }

  .project-thumbnail::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 15px;
    opacity: 0;
    transition: opacity var(--duration-md) ease;
    pointer-events: none;
    z-index: 1;
  }

  @media (hover: hover) {
    .project-thumbnail:hover .project-screenshot {
      transform: scale(1.01);
      transition: all var(--duration-md) ease;
    }

    .project-thumbnail:hover::before {
      opacity: 1;
    }
  }

  .project-screenshot {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    transition: transform var(--duration-md) ease-in-out;
    overflow: hidden;
  }

  @media (max-width: 500px) {
    .project-thumbnail {
      height: 250px;
    }
  }

  .project-caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-caption-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .project-title {
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 600;
    font-size: var(--font-md);
  }

  .project-subtitle {
    font-family: var(--font-sans);
    color: var(--color-typography-subtle);
    font-weight: 500;
    font-size: var(--font-md);
  }

  .project-caption-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .project-tag {
    font-family: var(--font-sans);
    color: var(--color-typography-subtle);
    font-weight: 500;
    font-size: var(--font-sm);
    background: var(--color-accent);
    padding: 4px 8px;
    border-radius: 5px;
  }

  footer {
    margin-top: var(--space-lg);
    font-family: var(--font-sans);
    color: var(--color-typography-subtle);
    font-size: var(--font-xs);
    text-align: center;
    padding: var(--space-md);
  }
</style>
