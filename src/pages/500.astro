---
import "../styles.css";
import { localeOptions } from "../i18n/ui";
import BaseLayout from "../layout/base-layout.astro";
import type { Language } from "../i18n/ui";

const params = Astro.params as { locale: string };
const locale = (localeOptions.find((opt) => opt === params.locale) ??
  "en") as Language;
---

<BaseLayout locale={locale}>
  <section class="error">
    <h1 class="title">Internal Server Error</h1>
    <p class="description">
      Something went wrong on our end. Please try again later or return to the
      homepage.
    </p>
    <a href="/" class="home-anchor">Go Back Home</a>
  </section>
</BaseLayout>

<style>
  .error {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
  }

  .title {
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 600;
    font-size: var(--font-lg);
    letter-spacing: -0.04em;
    text-align: center;
  }

  .description {
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 500;
    font-size: var(--font-sm);
    line-height: 1.5;
    text-align: center;
  }

  .home-anchor {
    width: fit-content;
    font-family: var(--font-sans);
    color: var(--color-typography-attention);
    font-weight: 600;
    font-size: var(--font-md);
    line-height: 1.5;
    text-align: center;
    cursor: pointer;
  }

  .home-anchor:hover {
    text-decoration: underline;
  }
</style>
